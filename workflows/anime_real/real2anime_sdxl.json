{
  "1": {
    "class_type": "CheckpointLoaderSimple",
    "_meta": { "title": "Checkpoint anime" },
    "inputs": { "ckpt_name": "animagineXL40_v4Opt.safetensors" }
  },
  "2": {
    "class_type": "LoadImage",
    "_meta": { "title": "Foto de entrada" },
    "inputs": { "image": "refer.jpeg" }
  },
  "3": {
    "class_type": "ImageScale",
    "_meta": { "title": "Escalar a 1024" },
    "inputs": {
      "image": ["2", 0],
      "upscale_method": "lanczos",
      "width": 1024,
      "height": 1024,
      "crop": "center"
    }
  },
  "4": {
    "class_type": "VAEEncode",
    "_meta": { "title": "Conserva composición y pose" },
    "inputs": { "pixels": ["3", 0], "vae": ["1", 2] }
  },
  "5": {
    "class_type": "CLIPTextEncode",
    "_meta": { "title": "Positivo (anime)" },
    "inputs": {
      "text": "anime key visual, masterpiece, best quality, clean lineart, cel shading, vibrant colors, detailed eyes, japanese animation style, consistent character design",
      "clip": ["1", 1]
    }
  },
  "6": {
    "class_type": "CLIPTextEncode",
    "_meta": { "title": "Negativo (anti-foto)" },
    "inputs": {
      "text": "photorealistic, photograph, photo, real life, skin pores, noisy, blurry, low quality, bad anatomy, extra fingers",
      "clip": ["1", 1]
    }
  },
  "7": {
    "class_type": "KSampler",
    "_meta": { "title": "Muestreo img2img" },
    "inputs": {
      "model": ["1", 0],
      "seed": 123456789,
      "steps": 28,
      "cfg": 6.0,
      "sampler_name": "dpmpp_2m",
      "scheduler": "karras",
      "positive": ["5", 0],
      "negative": ["6", 0],
      "latent_image": ["4", 0],
      "denoise": 0.55
    }
  },
  "8": {
    "class_type": "VAEDecode",
    "_meta": { "title": "Decodificar" },
    "inputs": { "samples": ["7", 0], "vae": ["1", 2] }
  },
  "9": {
    "class_type": "SaveImage",
    "_meta": { "title": "Guardar resultado" },
    "inputs": { "images": ["8", 0], "filename_prefix": "kukia_real2anime" }
  }
}
